# ---------------------------------------------------------------
# SelfishNet v2 - repository ignore rules
# ---------------------------------------------------------------

# Build output (any depth)
[Bb]in/
[Oo]bj/
publish/
TestResults/
artifacts/

# Debug symbols / logs produced by local builds
*.pdb
*.log
*.binlog
*.trx

# IDE / editor state
.vs/
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user

# OS noise
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Regenerable published single-file executable of the frozen prototype.
# It is ~154 MB and exceeds GitHub's 100 MB file limit; rebuild it with
# prototype/SelfishNetV2.Test/publish.bat if ever needed.
prototype/SelfishNetV2.Test/SelfishNetV2.exe

# Portable executables are deliverables, not source. They stay in the project
# root for convenience but are NOT versioned: committing them grows the repo by
# ~200 MB per build. Distribute via a GitHub Release instead. See tools/README.md.
SelfishNetV2-*.exe

# NOTE: the following are deliberately TRACKED (project material, not build output):
#   - GUIDE_EN.txt / GUIDE_ES.txt (user documentation)
#   - reference/**               (golden binaries, redistributables, RE tools)
#   - prototype/**               (frozen prototype source)
#   - docs/**, src/**            (specifications and application source)
