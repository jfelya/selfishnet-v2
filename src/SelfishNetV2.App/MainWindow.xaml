<Window x:Class="SelfishNetV2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SelfishNetV2.App.Controls"
        Title="SelfishNet v2"
        Width="1280" Height="780" MinWidth="1120" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="Auto"/>   <!-- driver banner -->
            <RowDefinition Height="*"/>      <!-- devices -->
            <RowDefinition Height="Auto"/>   <!-- charts -->
            <RowDefinition Height="Auto"/>   <!-- status -->
        </Grid.RowDefinitions>

        <!-- ================= toolbar ================= -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,9">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="BtnDiscover" Command="{Binding DiscoverCommand}" Margin="0,0,8,0"
                            ToolTipService.ShowOnDisabled="True"/>
                    <Button x:Name="BtnToggleShaping" Command="{Binding ToggleShapingCommand}"
                            Content="{Binding StartStopText}" MinWidth="112" Padding="16,7" Margin="0,0,16,0"
                            ToolTip="{Binding ShapingTooltip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShaping}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="BtnAdapter" Command="{Binding PickAdapterCommand}" Margin="0,0,20,0"/>

                    <TextBlock x:Name="LblEngine" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextDimBrush}" Margin="0,0,8,0"/>
                    <ToggleButton x:Name="TglLegacy" Content="Legacy" Style="{StaticResource SegmentedToggle}"
                                  IsChecked="{Binding IsEngineLegacy, Mode=OneWay}"
                                  Command="{Binding SwitchEngineCommand}" CommandParameter="Legacy" Margin="0,0,4,0"/>
                    <ToggleButton x:Name="TglModern" Content="Modern" Style="{StaticResource SegmentedToggle}"
                                  IsChecked="{Binding IsEngineModern, Mode=OneWay}"
                                  Command="{Binding SwitchEngineCommand}" CommandParameter="Modern"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="BtnUnits" Command="{Binding ToggleUnitsCommand}"
                            Content="{Binding UnitsButtonText}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnTheme" Command="{Binding ToggleThemeCommand}"
                            Content="{Binding ThemeButtonText}" Margin="0,0,20,0"/>
                    <Button x:Name="BtnLanguage" Command="{Binding ToggleLanguageCommand}"
                            Content="{Binding LanguageButtonText}" Margin="0,0,20,0"/>
                    <Button x:Name="BtnAbout" Command="{Binding AboutCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= driver banner ================= -->
        <Border Grid.Row="1" Background="{DynamicResource WarningBannerBrush}" Padding="14,8"
                Visibility="{Binding HasDriverProblem, Converter={StaticResource BoolToVis}}">
            <TextBlock x:Name="TxtDriverBanner" Foreground="{DynamicResource WarningTextBrush}"
                       TextWrapping="Wrap" ToolTip="{Binding DriverProblem}"/>
        </Border>

        <!-- ================= device grid ================= -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="12,12,12,0" ClipToBounds="True">
            <DataGrid x:Name="DeviceGrid" ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                      IsReadOnly="False" RowHeight="34" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="ColName" Width="2*" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding DisplayName}">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding RoleTag}" Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold" Margin="6,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}" MinWidth="140"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="ColIp" Width="108" CanUserSort="False" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IpText}" FontFamily="Consolas"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="ColMac" Width="148" CanUserSort="False" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MacText}" FontFamily="Consolas"
                                           Foreground="{DynamicResource TextDimBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="ColDown" Width="138" CanUserSort="False" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DownText}" Foreground="{DynamicResource ChartDownBrush}"
                                           FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="ColUp" Width="138" CanUserSort="False" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding UpText}" Foreground="{DynamicResource ChartUpBrush}"
                                           FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="ColDownCap" Width="126" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CapDownText}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding CapDownText, UpdateSourceTrigger=LostFocus}"
                                         HorizontalContentAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="ColUpCap" Width="126" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CapUpText}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding CapUpText, UpdateSourceTrigger=LostFocus}"
                                         HorizontalContentAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="ColBlock" Width="76" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Blocked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanEditFlags}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="ColSpoof" Width="94" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Targeted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanEditFlags}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================= charts ================= -->
        <Grid Grid.Row="3" Margin="12,12,12,0" Height="188">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <controls:BandwidthChartControl x:Name="TotalChart" Title=""/>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <controls:BandwidthChartControl x:Name="SelectedChart" Title=""/>
            </Border>
        </Grid>

        <!-- ================= status bar ================= -->
        <Border Grid.Row="4" Padding="14,8" Margin="0,10,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TextDimBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsShaping}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DevicesCountText}" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding TotalTrafficText}" Foreground="{DynamicResource TextBrush}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding EngineBadge}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ================= busy overlay ================= -->
        <Border Grid.RowSpan="5" Panel.ZIndex="10" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="340" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding BusyText}" HorizontalAlignment="Center" Margin="0,0,0,16"
                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
