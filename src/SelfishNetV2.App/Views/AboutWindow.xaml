<Window x:Class="SelfishNetV2.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Width="680" Height="720" MinWidth="580" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" FontWeight="Medium"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="SelfishNet v2" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtTagline" FontSize="14.5" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextDimBrush}"/>
            <TextBlock x:Name="TxtVersion" FontSize="12.5" Margin="0,10,0,0"
                       Foreground="{DynamicResource TextDimBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="TxtSummary" TextWrapping="Wrap" LineHeight="22"/>
                <StackPanel x:Name="PanelBullets" Margin="0,12,0,0"/>
                <TextBlock x:Name="TxtSafety" TextWrapping="Wrap" FontSize="12.5" Margin="0,14,0,0"
                           Foreground="{DynamicResource TextDimBrush}"/>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                        Margin="0,18,0,0" Padding="0,16,0,0">
                    <StackPanel>
                        <TextBlock x:Name="HdrSystem" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDimBrush}"/>
                        <StackPanel x:Name="PanelSystem" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                        Margin="0,18,0,0" Padding="0,16,0,0">
                    <StackPanel>
                        <TextBlock x:Name="HdrControl" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDimBrush}"/>
                        <StackPanel x:Name="PanelControl" Margin="0,10,0,0"/>
                        <TextBlock x:Name="TxtOsHint" TextWrapping="Wrap" FontSize="12"
                                   Margin="0,10,0,0" Foreground="{DynamicResource TextDimBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <TextBlock x:Name="TxtCopied" VerticalAlignment="Center" Margin="0,0,14,0"
                       Foreground="{DynamicResource SuccessBrush}" Visibility="Collapsed"/>
            <Button x:Name="BtnCopy" MinWidth="130" Margin="0,0,10,0"/>
            <Button x:Name="BtnClose" MinWidth="96" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
